# Copy to .env at the repo root and adjust. Never commit real secrets.
# Prisma scripts (db:generate / db:migrate / db:seed / db:studio) load this file via dotenv-cli.
#
# Production VPS: copy .env.production.example → .env.production and use
#   pnpm prod:up && pnpm prod:migrate
# Boot refuses production if mocks are on or secrets are weak.

NODE_ENV=development

# --- Local URLs (defaults) ---
# Web:    http://localhost:3000
# Admin:  http://localhost:3000/admin          (OWNER — seed user `admin`)
# Student http://localhost:3000/dashboard      (seed students e.g. `sara`)
# API:    http://localhost:4000/health
# Worker: http://localhost:4001/health
# MinIO:  http://localhost:9000  console :9001

# Web
WEB_ORIGIN=http://localhost:3000
# Canonical public origin for SEO (canonical/OG/sitemap/robots). Defaults to WEB_ORIGIN.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-side BFF → API (defaults to NEXT_PUBLIC_API_URL)
API_INTERNAL_URL=http://localhost:4000
# Opt-in HSTS on web + API. Leave false for local HTTP. Never inferred from NODE_ENV alone.
ENABLE_HSTS=false
# When true, public pages redirect to /maintenance. Login, recovery, /admin, and /api stay available.
MAINTENANCE_MODE=false

# API
API_PORT=4000

# Worker
WORKER_HEALTH_PORT=4001
REDIS_URL=redis://127.0.0.1:6379

# Postgres (docker-compose defaults)
DATABASE_URL=postgresql://zharfa:zharfa@127.0.0.1:5432/zharfa?schema=public

# MinIO (S3-compatible local object storage)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=zharfa
S3_SECRET_KEY=zharfadevpassword
S3_BUCKET=zharfa
S3_FORCE_PATH_STYLE=true

# Auth / sessions
SESSION_SECRET=change-me-in-local-dev-only
OTP_PEPPER=change-me-otp-pepper-local-only
# Auth rate-limit (Redis when available; falls back to in-memory)
AUTH_RATE_LIMIT=30
AUTH_RATE_WINDOW_MS=60000

# SEO / AI / security integrations (prefer Admin → Integrations in production)
# OPENAI_API_KEY is optional bootstrap; admin-stored encrypted key overrides when set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Shared token for Edge middleware → API security probe ingest (required in production; no SESSION_SECRET fallback)
INTERNAL_SECURITY_TOKEN=

# Seed passwords (pnpm db:seed) — local demo only
# Admin:  username `admin` / email admin@zharfa.local / phone 09120000000
# Student examples: sara, reza, niloofar, amir (see README)
SEED_ADMIN_PASSWORD=ChangeMeAdmin!23
SEED_STUDENT_PASSWORD=ChangeMeStudent!23

# --- Integrations (honest status) ---
# Empty payment/SpotPlayer credentials → IMPLEMENTED_BUT_CREDENTIALS_REQUIRED
# Do NOT invent successful payments or licenses. No VERIFIED_REAL_INTEGRATION without live creds.

# Payment adapters — leave empty until real merchant credentials exist.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
# AqayePardakht (https://aqayepardakht.ir/api/)
# Sandbox (default): leave PIN empty — adapter uses official pin `sandbox`
# and startpay URL …/startpay/sandbox/{transid}. Ready for local checkout.
# Production: set real gateway PIN and AQAYE_PARDAKHT_SANDBOX=false
# (also turn off سندباکس in /admin/payments).
AQAYE_PARDAKHT_PIN=
AQAYE_PARDAKHT_SANDBOX=true
# Public API base used in gateway callback_url (defaults to localhost:API_PORT)
# Must be reachable by AqayePardakht and share the approved callback domain.
API_PUBLIC_URL=http://localhost:4000
# Test-only mock adapters (unit/integration). NEVER enable in production.
# Mock still requires explicit verify — browser return alone never marks PAID.
PAYMENT_MOCK_HOOKS=false

# SpotPlayer — leave empty until real license API credentials exist.
# Official create endpoint: https://panel.spotplayer.ir/license/edit/ (docs: https://spotplayer.ir/help/api)
SPOTPLAYER_API_KEY=
SPOTPLAYER_LICENSE_ENDPOINT=https://panel.spotplayer.ir/license/edit/
# Test-only mock adapter (unit/worker). NEVER enable in production.
SPOTPLAYER_MOCK_HOOKS=false
SPOTPLAYER_MOCK_FAIL=false

# Email / SMS — no real provider credentials yet.
# Identity recovery OTP + notifications use console adapters (API logs only).
# Status: console provider (not a live MTA/SMS gateway).

# Support ticket attachments — private local store (never under apps/web/public)
# Empty → API default under OS temp / configured private path
TICKET_ATTACHMENT_ROOT=

# Notification outbound rate limits (email/SMS per user+channel; in-memory)
NOTIFY_RATE_LIMIT=20
NOTIFY_RATE_WINDOW_MS=60000
