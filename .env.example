# Copy to .env and adjust. Never commit real secrets.

NODE_ENV=development

# Web
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-side BFF → API (defaults to NEXT_PUBLIC_API_URL)
API_INTERNAL_URL=http://localhost:4000

# API
API_PORT=4000

# Worker
WORKER_HEALTH_PORT=4001
REDIS_URL=redis://127.0.0.1:6379

# Postgres (docker-compose defaults)
DATABASE_URL=postgresql://zharfa:zharfa@127.0.0.1:5432/zharfa?schema=public

# MinIO (S3-compatible local object storage)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=zharfa
S3_SECRET_KEY=zharfadevpassword
S3_BUCKET=zharfa
S3_FORCE_PATH_STYLE=true

# Auth / sessions
SESSION_SECRET=change-me-in-local-dev-only
OTP_PEPPER=change-me-otp-pepper-local-only
# In-memory rate-limit stub (per IP + bucket)
AUTH_RATE_LIMIT=30
AUTH_RATE_WINDOW_MS=60000

# Seed passwords (pnpm db:seed) — local demo only
SEED_ADMIN_PASSWORD=ChangeMeAdmin!23
SEED_STUDENT_PASSWORD=ChangeMeStudent!23

# Payment adapters — leave empty until real merchant credentials exist.
# Do NOT invent successful payments in local/dev stubs.
# When credentials are missing, checkout returns IMPLEMENTED_BUT_CREDENTIALS_REQUIRED
# and the web UI disables paid purchase.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
AQAYE_PARDAKHT_PIN=
AQAYE_PARDAKHT_SANDBOX=true
# Public API base used in gateway callback_url (defaults to localhost:API_PORT)
API_PUBLIC_URL=http://localhost:4000
# Test-only mock adapters (unit/integration). NEVER enable in production.
# Mock still requires explicit verify — browser return alone never marks PAID.
PAYMENT_MOCK_HOOKS=false

# SpotPlayer — leave empty until real license API credentials exist.
# Do NOT fake license success.
SPOTPLAYER_API_KEY=
SPOTPLAYER_LICENSE_ENDPOINT=
