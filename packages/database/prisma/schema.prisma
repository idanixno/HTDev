// Zharfa — Prisma schema.
// Domain models expand by phase. No fake payment/SpotPlayer success paths.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  OWNER
}

/// Lifecycle of a course listing (orthogonal to commercial offer).
enum CoursePublicationStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

/// Commercial / catalog face of a course (orthogonal to publication).
enum CourseOfferKind {
  FREE
  PAID
  PRE_SALE
  COMING_SOON
}

enum CourseDiagramKind {
  BOUNDARY
  CHAIN
}

enum OtpChannel {
  EMAIL
  SMS
}

enum OtpPurpose {
  PASSWORD_RECOVERY
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
}

model User {
  id                 String    @id @default(cuid())
  /// Display username as registered (preserves original casing).
  username           String
  /// Lowercased unique key for case-insensitive username uniqueness.
  usernameNormalized String    @unique
  /// Lowercased trimmed email.
  email              String    @unique
  /// E.164-ish Iranian local form (09XXXXXXXXX) when present.
  phone              String?   @unique
  displayName        String
  /// Telegram @handle without leading @ when set.
  telegramHandle     String?
  /// GitHub username when set.
  githubHandle       String?
  /// LinkedIn /in/ vanity slug when set.
  linkedinHandle     String?
  /// Stack Overflow /users/{id} or /users/{id}/{slug} path when set.
  stackOverflowHandle String?
  role               UserRole  @default(STUDENT)
  passwordHash       String
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions            Session[]
  otpChallenges       OtpChallenge[]
  enrollments         Enrollment[]
  orders              Order[]
  tickets             Ticket[]
  ticketMessages      TicketMessage[]
  ticketAttachments   TicketAttachment[]
  couponRedemptions   CouponRedemption[]
  spotPlayerLicenses  SpotPlayerLicense[]
  notifications       Notification[]
  activityLogs        ActivityLog[]
}

/// Opaque session tokens are stored hashed; raw token only lives in the cookie.
model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// OTP codes are stored as secure hashes; plaintext is never persisted.
model OtpChallenge {
  id                    String     @id @default(cuid())
  userId                String?
  channel               OtpChannel
  purpose               OtpPurpose
  destinationNormalized String
  codeHash              String
  expiresAt             DateTime
  consumedAt            DateTime?
  attemptCount          Int        @default(0)
  maxAttempts           Int        @default(5)
  createdAt             DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([destinationNormalized, purpose, channel])
  @@index([expiresAt])
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  summary   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses Course[]
}

model Course {
  id                String                  @id @default(cuid())
  slug              String                  @unique
  title             String
  summary           String?
  description       String?
  categoryId        String?
  publicationStatus CoursePublicationStatus @default(DRAFT)
  offerKind         CourseOfferKind         @default(COMING_SOON)
  /// List / checkout price in Toman (Decimal for fractional pricing if needed).
  priceToman        Decimal                 @default(0) @db.Decimal(12, 2)
  /// Optional compare-at / strikethrough price in Toman.
  compareAtToman    Decimal?                @db.Decimal(12, 2)
  levelLabel        String?
  durationHours     Decimal?                @db.Decimal(6, 2)
  lessonCount       Int                     @default(0)
  featured          Boolean                 @default(false)
  sortOrder         Int                     @default(0)
  /// Local public asset path for cover/artwork placeholder (e.g. /artwork/courses/…).
  coverAsset        String?
  /// Optional public intro/preview video for the course detail hero (poster = coverAsset).
  previewAsset      String?
  indexLabel        String?
  diagramCode       String?
  diagramKind       CourseDiagramKind       @default(BOUNDARY)
  /// Up to three chain-node labels for CourseCard chain diagrams.
  chainNodes        String[]                @default([])
  /// Optional SEO overrides (fall back to title/summary when null).
  seoTitle          String?
  seoDescription    String?
  ogImage           String?
  noIndex           Boolean                 @default(false)
  publishedAt       DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  category              Category?                  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  modules               CurriculumModule[]
  lessons               Lesson[]
  enrollments           Enrollment[]
  orders                Order[]
  learningPathSteps     LearningPathStep[]
  spotPlayerMapping     SpotPlayerCourseMapping?
  spotPlayerLicenses    SpotPlayerLicense[]
  tickets               Ticket[]
  waitlistEntries       CourseWaitlistEntry[]
  purchaseNotes         CoursePurchaseNote[]

  @@index([publicationStatus, offerKind])
  @@index([categoryId])
  @@index([featured, sortOrder])
}

/// Notes shown in the course «قبل از خرید» block.
/// `courseId = null` → global (all courses); set → exclusive to that course.
model CoursePurchaseNote {
  id        String   @id @default(cuid())
  courseId  String?
  /// Plain text; optional markdown link `[برچسب](/path)`.
  body      String
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, published, sortOrder])
  @@index([published, sortOrder])
}

/// Phone interest for COMING_SOON courses. SMS is console/dev until a real gateway exists.
model CourseWaitlistEntry {
  id         String    @id @default(cuid())
  courseId   String
  /// Normalized Iranian mobile 09XXXXXXXXX.
  phone      String
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, phone])
  @@index([courseId, notifiedAt])
}

/// Curriculum section within a course (ordered chapters).
model CurriculumModule {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  summary   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, sortOrder])
}

model Lesson {
  id              String   @id @default(cuid())
  courseId        String
  moduleId        String?
  title           String
  summary         String?
  sortOrder       Int      @default(0)
  durationMinutes Int?
  isPreview       Boolean  @default(false)
  /// Public sample file. Exposed only while isPreview is true. Paid lessons stay in SpotPlayer.
  previewAsset    String?
  /// Lesson video. Every syllabus lesson can be watched on the course page.
  videoAsset      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module CurriculumModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  @@index([courseId, sortOrder])
  @@index([moduleId, sortOrder])
}

/// Learning roadmap / path (مسیر یادگیری).
model LearningPath {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String?
  description String?
  coverAsset  String?
  published   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps LearningPathStep[]

  @@index([published, sortOrder])
}

model LearningPathStep {
  id             String   @id @default(cuid())
  pathId         String
  courseId       String?
  /// Unique inside the path. Public URL is /paths/{path}/{slug}.
  slug           String
  title          String
  summary        String?
  /// Same markdown as journal notes: headings, tables, images, video, code, !course[slug].
  body           String   @default("")
  seoTitle       String?
  seoDescription String?
  ogImage        String?
  noIndex        Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  path   LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  course Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@unique([pathId, slug])
  @@index([pathId, sortOrder])
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

/// Order lifecycle. Valid transitions are enforced in application code
/// (see commerce/order-status.ts) — never jump to PAID without gateway verify.
enum OrderStatus {
  PENDING
  AWAITING_GATEWAY
  PAID
  FAILED
  REFUNDED
  CANCELED
}

/// Per-attempt payment attempt lifecycle (one Order may retry with new rows).
enum PaymentTransactionStatus {
  CREATED
  REDIRECTED
  CALLBACK_RECEIVED
  VERIFIED
  FAILED
  CANCELED
}

enum PaymentProvider {
  ZARINPAL
  AQAYE_PARDAKHT
}

enum CouponDiscountType {
  PERCENT
  FIXED_TOMAN
}

/// Whether merchant credentials are available in process env (not secrets in DB).
enum GatewayCredentialsStatus {
  MISSING
  PRESENT
}

model Coupon {
  id               String             @id @default(cuid())
  /// Display code as entered by admin (preserves casing for UX).
  code             String
  /// Uppercased unique key for case-insensitive lookup.
  codeNormalized   String             @unique
  discountType     CouponDiscountType
  /// 0–100 when discountType = PERCENT.
  percentOff       Decimal?           @db.Decimal(5, 2)
  /// Fixed Toman off when discountType = FIXED_TOMAN.
  amountOffToman   Decimal?           @db.Decimal(12, 2)
  minOrderToman    Decimal?           @db.Decimal(12, 2)
  maxDiscountToman Decimal?           @db.Decimal(12, 2)
  startsAt         DateTime?
  endsAt           DateTime?
  maxRedemptions   Int?
  redemptionCount  Int                @default(0)
  active           Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  orders      Order[]
  redemptions CouponRedemption[]

  @@index([active, endsAt])
}

/// Audit of successful coupon use (incremented only when order becomes PAID).
model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  orderId    String   @unique
  userId     String
  createdAt  DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
}

/// Orders never auto-mark PAID without a verified gateway callback/verify.
model Order {
  id              String           @id @default(cuid())
  userId          String
  courseId        String
  couponId        String?
  /// Snapshot of coupon code at checkout time.
  couponCode      String?
  /// Course list price in Toman at checkout (server-side, never trust client).
  listPriceToman  Decimal          @db.Decimal(12, 2)
  discountToman   Decimal          @default(0) @db.Decimal(12, 2)
  /// Payable amount in Toman after coupon (Decimal money).
  amountToman     Decimal          @db.Decimal(12, 2)
  /// IRT = Toman (ZarinPal currency code); amounts are always Toman.
  currency        String           @default("IRT")
  status          OrderStatus      @default(PENDING)
  paymentProvider PaymentProvider?
  paidAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  course             Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  coupon             Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  transactions       PaymentTransaction[]
  redemption         CouponRedemption?
  spotPlayerLicenses SpotPlayerLicense[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([courseId])
}

/// One gateway attempt. Duplicate callbacks are idempotent via authority + status.
model PaymentTransaction {
  id               String                   @id @default(cuid())
  orderId          String
  provider         PaymentProvider
  status           PaymentTransactionStatus @default(CREATED)
  amountToman      Decimal                  @db.Decimal(12, 2)
  /// ZarinPal authority / AqayePardakht transid.
  gatewayAuthority String?
  /// ZarinPal ref_id / AqayePardakht tracking_number after successful verify.
  gatewayRefId     String?
  callbackPayload  Json?
  verifyPayload    Json?
  /// Stable key for idempotent callback processing (provider + authority).
  idempotencyKey   String                   @unique
  failureReason    String?
  verifiedAt       DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, gatewayAuthority])
  @@index([orderId, status])
}

/// Admin-tunable gateway flags. Secrets stay in env — never persisted here.
/// technicalEnabled: adapter may be invoked when credentials PRESENT.
/// checkoutVisible: offered on the student checkout UI.
/// isDefault: preferred selectable gateway when multiple are usable.
model PaymentGatewaySetting {
  id                 String                    @id @default(cuid())
  provider           PaymentProvider           @unique
  technicalEnabled   Boolean                   @default(false)
  checkoutVisible    Boolean                   @default(false)
  isDefault          Boolean                   @default(false)
  sandboxMode        Boolean                   @default(true)
  /// Cached reflection of env presence for admin UI; runtime still re-checks env.
  credentialsStatus  GatewayCredentialsStatus  @default(MISSING)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
}

/// Support ticket lifecycle. Transitions enforced in tickets/ticket-status.ts.
enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  CLOSED
}

enum TicketAuthorRole {
  STUDENT
  ADMIN
  SYSTEM
}

model Ticket {
  id          String       @id @default(cuid())
  userId      String
  /// Optional link to a catalog course (support context).
  courseId    String?
  subject     String
  description String
  status      TicketStatus @default(OPEN)
  /// Supplementary only — tickets are primary; Telegram is optional metadata.
  telegramRef String?
  resolvedAt  DateTime?
  closedAt    DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  messages     TicketMessage[]
  attachments  TicketAttachment[]

  @@index([userId, createdAt])
  @@index([status, updatedAt])
  @@index([courseId])
}

model TicketMessage {
  id         String           @id @default(cuid())
  ticketId   String
  authorId   String?
  authorRole TicketAuthorRole
  body       String
  createdAt  DateTime         @default(now())

  ticket      Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  attachments TicketAttachment[]

  @@index([ticketId, createdAt])
}

/// Attachment metadata only. Bytes live in private object storage (MinIO/local).
/// Never expose raw filesystem paths; download via authenticated API only.
model TicketAttachment {
  id           String   @id @default(cuid())
  ticketId     String
  messageId    String?
  uploadedById String
  /// Opaque object key inside the private bucket/prefix (no path traversal).
  storageKey   String   @unique
  /// Original client filename (sanitized for display; not used as storage path).
  fileName     String
  contentType  String
  sizeBytes    Int
  /// SHA-256 hex of content for integrity / dedupe hints.
  contentSha256 String?
  createdAt    DateTime @default(now())

  ticket     Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message    TicketMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploadedBy User           @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([messageId])
}

/// Domain events that fan out to in-app + email/SMS deliveries.
enum NotificationEventType {
  USER_REGISTERED
  ORDER_PAID
  ORDER_FAILED
  ACCESS_PROVISIONED
  ACCESS_PROVISION_FAILED
  TICKET_CREATED
  TICKET_REPLY
  TICKET_STATUS_CHANGED
  SECURITY_RECOVERY_REQUESTED
  SECURITY_PASSWORD_CHANGED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Notification {
  id        String                @id @default(cuid())
  userId    String
  eventType NotificationEventType
  title     String
  body      String
  /// Structured event payload (ids, links) — never secrets.
  payload   Json?
  readAt    DateTime?
  createdAt DateTime              @default(now())

  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([eventType, createdAt])
}

model NotificationDelivery {
  id             String                      @id @default(cuid())
  notificationId String
  channel        NotificationChannel
  status         NotificationDeliveryStatus  @default(PENDING)
  templateKey    String
  /// Destination used (email/phone). Prefer masked in logs; full value for delivery only.
  destination    String?
  error          String?
  attemptCount   Int                         @default(0)
  sentAt         DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId, channel])
  @@index([status, createdAt])
}

/// Separate from OrderStatus — payment PAID does not imply license success.
enum SpotPlayerLicenseStatus {
  PENDING
  QUEUED
  IN_PROGRESS
  SUCCEEDED
  FAILED
}

/// How access was granted (payment vs free enroll). Orthogonal to license status.
enum SpotPlayerAccessSource {
  PAID_ORDER
  FREE_COURSE
}

/// Singleton-ish SpotPlayer integration settings. API key prefers env; optional
/// encrypted DB override exists for admin UI. Never return full key in API.
model SpotPlayerSetting {
  id                String                   @id @default("default")
  technicalEnabled  Boolean                  @default(false)
  /// When true, license create sends test:true per official SpotPlayer API docs.
  testMode          Boolean                  @default(true)
  /// AES-256-GCM ciphertext (base64) of API key when set via admin (env wins if present).
  apiKeyEncrypted   String?
  /// Last 4 chars for masked admin display only.
  apiKeyLast4       String?
  /// Cached reflection; runtime still re-checks env + decrypted key.
  credentialsStatus GatewayCredentialsStatus @default(MISSING)
  /// Override for POST license endpoint; default is official panel URL.
  licenseEndpoint   String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
}

/// Maps a Zharfa course to a SpotPlayer panel course id (required for license create).
model SpotPlayerCourseMapping {
  id                 String   @id @default(cuid())
  courseId           String   @unique
  /// SpotPlayer course ObjectId from the instructor panel (official `course` array field).
  spotPlayerCourseId String
  enabled            Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([spotPlayerCourseId])
}

/// SpotPlayer licenses are provisioned only after verified paid/free access — never stubbed as success.
model SpotPlayerLicense {
  id                   String                  @id @default(cuid())
  userId               String
  courseId             String
  orderId              String?
  accessSource         SpotPlayerAccessSource
  /// Official SpotPlayer license `_id` from create response.
  spotPlayerLicenseId  String?
  /// Official SpotPlayer license `key` — only set after real provider response.
  licenseKey           String?
  /// Relative path from provider `url` (prefix with https://dl.spotplayer.ir).
  licenseUrl           String?
  status               SpotPlayerLicenseStatus @default(PENDING)
  attemptCount         Int                     @default(0)
  lastError            String?
  lastAttemptAt        DateTime?
  provisionedAt        DateTime?
  /// Stable key for queue/idempotency (e.g. access:userId:courseId).
  idempotencyKey       String                  @unique
  /// Raw provider response (admin diagnostics); never invent keys here.
  providerPayload      Json?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order  Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([status, updatedAt])
  @@index([orderId])
}

/// Admin / system audit trail. No secrets in metadata.
enum ActivityActorKind {
  OWNER
  SYSTEM
}

model ActivityLog {
  id         String            @id @default(cuid())
  actorKind  ActivityActorKind @default(OWNER)
  actorId    String?
  action     String
  entityType String
  entityId   String?
  summary    String
  /// Structured non-secret context (ids, before/after field names — never passwords/keys).
  metadata   Json?
  createdAt  DateTime          @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

/// Editable FAQ rows for public CMS basics.
model CmsFaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

/// Educational notes published by the instructor (not a multi-author magazine).
model Article {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  summary        String?
  /// Markdown: headings, lists, links, images, !video, and fenced code.
  body            String
  coverAsset      String?
  seoTitle        String?
  seoDescription  String?
  ogImage         String?
  noIndex         Boolean   @default(false)
  published       Boolean   @default(false)
  publishedAt     DateTime?
  readingMinutes  Int?
  sortOrder       Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([published, sortOrder])
}

/// Singleton home / landing CMS copy (id = "home").
model CmsHomeContent {
  id               String   @id @default("home")
  heroEyebrow      String?
  heroTitle        String
  heroSubtitle     String?
  primaryCtaLabel  String?
  primaryCtaHref   String?
  secondaryCtaLabel String?
  secondaryCtaHref String?
  /// When true and announcementText is set, show a strip at the top of the home page.
  announcementEnabled Boolean @default(false)
  announcementText    String?
  /// Optional link for the announcement CTA (relative or https).
  announcementHref    String?
  announcementCtaLabel String?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}

/// Singleton paths / roadmap index CMS copy (id = "paths").
model CmsPathsContent {
  id             String   @id @default("paths")
  title          String   @default("نقشهٔ راه یادگیری")
  lead           String?
  seoTitle       String?
  seoDescription String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

/// Singleton site chrome (id = "footer"): header + footer + trust badges.
model CmsFooterContent {
  id                   String   @id @default("footer")
  /// Brand wordmark (header + footer).
  brandName            String   @default("DXCode")
  /// Header tagline next to brand.
  brandTagline         String?
  /// Footer kicker above brand (e.g. استودیو).
  brandKicker          String?
  /// Footer descriptive blurb.
  footerBlurb          String?
  /// Header primary nav: [{ href, label, match? }]
  headerLinks          Json?
  /// Footer menu columns: [{ label, links: [{ href, label }] }]
  footerGroups         Json?
  /// Mobile drawer groups (falls back to footerGroups).
  mobileGroups         Json?
  guestCtaLabel        String?
  guestCtaHref         String?
  authedCtaLabel       String?
  authedCtaHref        String?
  showCart             Boolean  @default(true)
  showThemeToggle      Boolean  @default(true)
  trustsLabel          String?
  mobileMenuTitle      String?
  mobileMenuLine       String?
  /// Enamad / e-namad seal embed HTML (anchor + img).
  enamadHtml           String?
  /// Payment gateway trust badge embed HTML.
  paymentGatewayHtml   String?
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())
}

enum IntegrationProvider {
  OPENAI
  ANTHROPIC
  GOOGLE_OAUTH
}

/// Encrypted third-party credentials managed from admin Integrations.
/// Never return decrypted secrets to the client — only masked previews + status.
model IntegrationCredential {
  id                 String                    @id @default(cuid())
  provider           IntegrationProvider       @unique
  /// AES-GCM ciphertext for primary secret (API key or OAuth client secret).
  secretEncrypted    String?
  /// Non-secret companion fields (e.g. Google OAuth client id) as JSON.
  configJson         Json?
  credentialsStatus  GatewayCredentialsStatus  @default(MISSING)
  /// Last 4 chars of secret for admin UI mask.
  secretLast4        String?
  /// OAuth refresh token ciphertext when Google is connected (null until connect).
  oauthRefreshEncrypted String?
  oauthAccessEncrypted  String?
  oauthAccessExpiresAt  DateTime?
  connectedAt        DateTime?
  lastTestedAt       DateTime?
  lastError          String?
  updatedAt          DateTime                  @updatedAt
  createdAt          DateTime                  @default(now())
}

enum SeoEntityType {
  COURSE
  ARTICLE
  PATH_STEP
}

enum SeoSuggestionDecision {
  ACCEPTED
  REJECTED
  EDITED
}

model SeoSuggestionLog {
  id         String                 @id @default(cuid())
  entityType SeoEntityType
  entityId   String?
  action     String
  decision   SeoSuggestionDecision?
  actorId    String?
  summary    String?
  createdAt  DateTime               @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

enum SecurityEventType {
  SUSPICIOUS_PATH
  RATE_LIMIT
  UNAUTHORIZED_ADMIN
  AUTH_FAILURE
  API_ABUSE
}

model SecurityEvent {
  id        String            @id @default(cuid())
  type      SecurityEventType
  path      String
  method    String?
  /// SHA-256 hex of IP (never store raw IP in this table).
  ipHash    String?
  userAgent String?
  metaJson  Json?
  createdAt DateTime          @default(now())

  @@index([type, createdAt])
  @@index([createdAt])
}
