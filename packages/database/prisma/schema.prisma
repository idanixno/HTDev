// Zharfa — Prisma schema.
// Domain models expand by phase. No fake payment/SpotPlayer success paths.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  OWNER
}

enum CourseAvailability {
  PUBLISHED_PAID
  PUBLISHED_FREE
  PREORDER
  IN_PRODUCTION
  COMING_SOON
  UNAVAILABLE
}

enum OtpChannel {
  EMAIL
  SMS
}

enum OtpPurpose {
  PASSWORD_RECOVERY
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
}

model User {
  id                 String    @id @default(cuid())
  /// Display username as registered (preserves original casing).
  username           String
  /// Lowercased unique key for case-insensitive username uniqueness.
  usernameNormalized String    @unique
  /// Lowercased trimmed email.
  email              String    @unique
  /// E.164-ish Iranian local form (09XXXXXXXXX) when present.
  phone              String?   @unique
  displayName        String
  role               UserRole  @default(STUDENT)
  passwordHash       String
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions      Session[]
  otpChallenges OtpChallenge[]
  enrollments   Enrollment[]
  orders        Order[]
  tickets       Ticket[]
}

/// Opaque session tokens are stored hashed; raw token only lives in the cookie.
model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// OTP codes are stored as secure hashes; plaintext is never persisted.
model OtpChallenge {
  id                     String     @id @default(cuid())
  userId                 String?
  channel                OtpChannel
  purpose                OtpPurpose
  destinationNormalized  String
  codeHash               String
  expiresAt              DateTime
  consumedAt             DateTime?
  attemptCount           Int        @default(0)
  maxAttempts            Int        @default(5)
  createdAt              DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([destinationNormalized, purpose, channel])
  @@index([expiresAt])
}

model Course {
  id           String             @id @default(cuid())
  slug         String             @unique
  title        String
  summary      String?
  priceToman   Int                @default(0)
  availability CourseAvailability @default(COMING_SOON)
  publishedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  enrollments Enrollment[]
  orders      Order[]
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

enum OrderStatus {
  PENDING
  AWAITING_GATEWAY
  PAID
  FAILED
  REFUNDED
  CANCELED
}

enum PaymentProvider {
  ZARINPAL
  AQAYE_PARDAKHT
}

/// Orders never auto-mark PAID without a verified gateway callback.
model Order {
  id              String           @id @default(cuid())
  userId          String
  courseId        String
  amountToman     Int
  status          OrderStatus      @default(PENDING)
  paymentProvider PaymentProvider?
  gatewayRef      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Ticket {
  id        String       @id @default(cuid())
  userId    String
  subject   String
  body      String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// SpotPlayer licenses are provisioned only after verified paid/free access — never stubbed as success.
model SpotPlayerLicense {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  licenseKey String?
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, courseId])
}
