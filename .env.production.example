# Copy to .env.production and fill real secrets. Never commit .env.production.
# docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

NODE_ENV=production

# --- Public HTTPS origins (required) ---
WEB_ORIGIN=https://zharfa.example.com
NEXT_PUBLIC_SITE_URL=https://zharfa.example.com
# Browser-facing API origin (or same host if reverse-proxied)
NEXT_PUBLIC_API_URL=https://api.zharfa.example.com
# Gateway callbacks must reach this URL from the internet
API_PUBLIC_URL=https://api.zharfa.example.com
# Inside Docker network the compose file overrides API_INTERNAL_URL to http://api:4000

ENABLE_HSTS=true
# Temporary IP-only testing over http:// (disables https check + Secure cookies). Never leave true.
ALLOW_INSECURE_HTTP=false
MAINTENANCE_MODE=false

# --- Postgres (compose injects DATABASE_URL; these feed the compose service) ---
POSTGRES_USER=zharfa
POSTGRES_PASSWORD=replace-with-long-random-db-password
POSTGRES_DB=zharfa
# Optional override if not using compose postgres:
# DATABASE_URL=postgresql://zharfa:...@postgres:5432/zharfa?schema=public
# REDIS_URL=redis://redis:6379

# --- Secrets (≥24 chars, unique, not equal to each other) ---
SESSION_SECRET=replace-with-long-random-session-secret-value
OTP_PEPPER=replace-with-different-long-random-otp-pepper
INTERNAL_SECURITY_TOKEN=replace-with-different-long-random-internal-token

AUTH_RATE_LIMIT=30
AUTH_RATE_WINDOW_MS=60000

# --- Integrations (leave empty until live credentials exist) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
AQAYE_PARDAKHT_PIN=
AQAYE_PARDAKHT_SANDBOX=false

SPOTPLAYER_API_KEY=
SPOTPLAYER_LICENSE_ENDPOINT=https://panel.spotplayer.ir/license/edit/

# MUST stay false in production (boot refuses otherwise)
PAYMENT_MOCK_HOOKS=false
SPOTPLAYER_MOCK_HOOKS=false
SPOTPLAYER_MOCK_FAIL=false

# Ticket attachments (compose sets TICKET_ATTACHMENT_ROOT=/data/ticket-attachments)
TICKET_ATTACHMENT_ROOT=/data/ticket-attachments
# Uploaded course/article images and lesson videos (compose mounts persistent storage here)
MEDIA_UPLOAD_DIR=/data/media

NOTIFY_RATE_LIMIT=20
NOTIFY_RATE_WINDOW_MS=60000

# Optional ClamAV for ticket attachments
CLAMAV_ENABLED=false
CLAMAV_REQUIRED=false

# Ports inside containers (compose maps 127.0.0.1 only)
API_PORT=4000
WORKER_HEALTH_PORT=4001
